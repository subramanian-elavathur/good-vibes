{
  "name": "good-vibes",
  "version": "2.0.0",
  "description": "Good Vibes is a Node.js testing library inspired by Alicia Keys Tiny Desk Concert",
  "keywords": [
    "good-vibes",
    "good",
    "vibes",
    "alicia",
    "keys",
    "nodejs",
    "testing",
    "test",
    "tests",
    "library",
    "testing-library",
    "snapshot"
  ],
  "homepage": "https://github.com/subramanian-elavathur/good-vibes#readme",
  "bugs": {
    "url": "https://github.com/subramanian-elavathur/good-vibes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subramanian-elavathur/good-vibes.git"
  },
  "license": "MIT",
  "author": "Subramanian Elavathur",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "lint:package": "attw --pack .",
    "format": "prettier --write .",
    "test": "npm run build && node --test \"test/**/*.test.mts\"",
    "coverage": "npm run build && c8 node --test \"test/**/*.test.mts\"",
    "examples": "npm run build && node examples/index.mjs",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22"
  }
}
